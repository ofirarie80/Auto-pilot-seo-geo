# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Protects /api/geo/run. Any long random string. ──
CRON_SECRET=

# ── AI engines for GEO tracking. Any engine without a key is skipped. ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash
# PERPLEXITY_MODEL=sonar
# GEO_CONCURRENCY=4

# Public address of the app, used in the WhatsApp message link
NEXT_PUBLIC_APP_URL=

# ── Weekly WhatsApp report via Green API (optional) ──
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
# Your number, international format without +, e.g. 972501234567
WHATSAPP_TO=
# GREEN_API_URL=https://api.green-api.com

# ── Weekly report by email via Resend (optional) ──
RESEND_API_KEY=
# Sender on a verified domain, e.g. Lionet Pilot <reports@lionet.co.il>
REPORT_FROM=
